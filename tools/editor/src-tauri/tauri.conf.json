{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openbse-workbench",
  "version": "0.2.3",
  "identifier": "org.openbse.workbench",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenBSE Workbench",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../docs/openbse_schema.json": "docs/openbse_schema.json",
      "../../../examples": "examples",
      "binaries/openbse*": "./"
    }
  }
}
