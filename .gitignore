# ─── Rust Build Artifacts ─────────────────────────────────────────────────────
/target/
**/target/
debug/
**/*.rs.bk

# ─── Cargo Lock (optional for libraries, keep for binaries) ──────────────────
# Uncomment if this is a pure library crate:
# Cargo.lock

# ─── IDE / Editor ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── Claude Code local settings ──────────────────────────────────────────────
.claude/settings.local.json

# ─── OS Files ────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db

# ─── Simulation Output Files ─────────────────────────────────────────────────
# These are generated by running the engine and should not be committed.
results.csv
summary_report.txt
*_results.csv
*_summary.txt
*_sizing.csv
*_zone_results.csv
*_zone_sizing.csv
*_system_sizing.csv

# ─── Duplicate schema at root (canonical copy is in docs/) ───────────────────
/openbse_schema.json

# ─── EnergyPlus Validation Output ────────────────────────────────────────────
prototype_tests/output_*/
prototype_tests/*.err
prototype_tests/**/*.err

# E+ transient run artifacts (regenerated every run)
**/eplus_run/eplusout.eso
**/eplus_run/eplusout.mtr
**/eplus_run/eplusout.audit
**/eplus_run/eplusout.bnd
**/eplus_run/eplusout.dxf
**/eplus_run/eplusout.eio
**/eplus_run/eplusout.end
**/eplus_run/eplusout.mdd
**/eplus_run/eplusout.mtd
**/eplus_run/eplusout.rdd
**/eplus_run/eplusout.rvaudit
**/eplus_run/eplusout.shd
**/eplus_run/eplusout.csv
**/eplus_run/eplusssz.csv
**/eplus_run/epluszsz.csv
**/eplus_run/epluspsz.csv
**/eplus_run/eplustbl.htm
**/eplus_run/in.idf
**/eplus_run/eplusmtr.csv
# Catch any eplus_*_run/ directories (e.g. eplus_denver_run)
**/eplus_*_run/

# OpenBSE and example run error logs
examples/*.err

# macOS duplicate files (Finder copy artifacts)
* 2.*
* 3.*

# ─── ASHRAE 140 Test Outputs (reproducible from running OpenBSE) ────────────
140_tests/cases/*_results.csv
140_tests/cases/*_summary.txt
140_tests/cases/*_zone_results.csv
140_tests/cases/*_energy_monthly.csv
140_tests/cases/*_hvac_results.csv
140_tests/cases/*.err
140_tests/reference_idfs/*_out/

# ASHRAE 140 accompanying reference files (large, not ours)
140_tests/cases/ASHRAE 140-2023 Accompanying FIles/

# ─── Node.js ─────────────────────────────────────────────────────────────────
node_modules/
package-lock.json
package.json

# ─── Debug / Temporary ───────────────────────────────────────────────────────
debug_output.txt
next_session_prompt.md
*.stderr.txt
apt_stderr.txt

# ─── Weather Files ───────────────────────────────────────────────────────────
# EPW files are large and user-specific (local paths).
*.epw
# Exception: ASHRAE 140 weather file and aggregated results must be committed
!140_tests/weather/*.epw
!140_tests/results/FULL_140_RESULTS.csv

# ─── Environment / Secrets ───────────────────────────────────────────────────
.env
.env.*
